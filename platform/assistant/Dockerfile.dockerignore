# Build context is the repo ROOT. BuildKit uses this file INSTEAD of the
# repo-root .dockerignore. An allowlist of what the Dockerfile COPYs, so
# nothing else in the repo is ever sent.
*
!platform/assistant/pyproject.toml
!platform/assistant/uv.lock
!platform/assistant/hexgate_assistant
**/__pycache__
**/*.py[cod]
