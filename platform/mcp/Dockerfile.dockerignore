# Build context is the repo ROOT. BuildKit uses this file INSTEAD of the
# repo-root .dockerignore. It mirrors that file, with ONE difference: it keeps
# docs/policy/, which the policy reference tool serves from the image.

**/.venv
**/__pycache__
**/*.py[cod]
**/*.egg-info
**/.pytest_cache
**/.ruff_cache
build/
dist/
**/*.db*
platform/api/data/
**/.env
.git
.github
.gitignore
.DS_Store
.vscode
.idea
**/node_modules
platform/dashboard/
platform/clickhouse/
docs/*
!docs/policy/
notebooks/
_design/
examples/
assets/
tests/
platform/api/tests/
