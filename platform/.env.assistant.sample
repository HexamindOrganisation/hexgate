# Key reference for platform/.env.<stage>.assistant, the policy assistant's
# secrets, pulled from the Scaleway secret /hexgate/<stage>-assistant; why it is
# apart from .env.<stage>: DEPLOY.md section 3.
# Generate secrets: openssl rand -hex 32

# Required: the password of the assistant's own Postgres login, which
# assistant-db-init creates (or re-sets) on every `make platform-up`. Never the main
# HEXGATE_POSTGRES_PASSWORD.
HEXGATE_ASSISTANT_POSTGRES_PASSWORD=<strong-password>

# Optional until the stage is enabled: unset, the assistant will run no chat turn.
# Set a credit limit with a daily reset on the key at OpenRouter first.
# HEXGATE_ASSISTANT_MODEL=<model string, in the assistant's format>
# HEXGATE_ASSISTANT_OPENROUTER_KEY=<openrouter key>
