# Build context is the repo ROOT. BuildKit uses this file INSTEAD of the
# repo-root .dockerignore. An allowlist of what the Dockerfile COPYs, so
# nothing else in the repo — a stray .env.prod, a keystore, a local database —
# is ever sent to the builder, let alone baked into a published image.
*

# SDK source (the hexgate wheel is built from it).
!pyproject.toml
!README.md
!LICENSE
!hexgate

# API source.
!platform/api/pyproject.toml
!platform/api/uv.lock
!platform/api/hexgate_api

# Dashboard build inputs (the `dashboard` stage builds the SPA in-image).
!platform/dashboard/package.json
!platform/dashboard/pnpm-lock.yaml
!platform/dashboard/index.html
!platform/dashboard/components.json
!platform/dashboard/tsconfig*.json
!platform/dashboard/vite.config.ts
!platform/dashboard/public
!platform/dashboard/src

# Backstop, after the re-includes so it wins: never secrets or state, even
# under a re-included directory. Vite inlines VITE_* from .env* files into
# the public bundle, so a dashboard .env.local would ship to every visitor.
**/.env*
**/*.priv
**/*.pem
**/*.private
**/*.db*
**/__pycache__
**/*.py[cod]
