# Fallback for any repo-root build without its own <Dockerfile>.dockerignore.
# Every Dockerfile in the repo has one (an allowlist), which BuildKit uses
# INSTEAD of this file; this keeps an ad-hoc root build free of secrets/state.

# Virtualenvs — never copy a host venv over the container's (wrong arch).
**/.venv

# Python caches + build artifacts
**/__pycache__
**/*.py[cod]
**/*.egg-info
**/.pytest_cache
**/.ruff_cache
build/
dist/

# Local databases + keystore — state/secrets, must not be baked into the image
**/*.db*
platform/api/data/

# Env files and keys — config and secrets are provided at runtime, never via
# the image. **/.env alone misses .env.prod, .env.local, …
**/.env*
!**/.env.sample
**/*.priv
**/*.pem
**/*.private

# VCS / CI / tooling
.git
.github
.gitignore
.DS_Store
.vscode
.idea

# Not part of the API image
**/node_modules
platform/dashboard/
platform/clickhouse/
docs/
notebooks/
_design/
examples/
assets/
tests/
platform/api/tests/
